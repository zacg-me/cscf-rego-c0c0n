{
  "format_version": "1.2",
  "terraform_version": "1.15.5",
  "swift_account_id": "111122223333",
  "planned_values": {
    "root_module": {
      "resources": [
        {
          "address": "aws_instance.reporting_host",
          "type": "aws_instance",
          "name": "reporting_host",
          "values": {
            "instance_type": "m5.large",
            "key_name": "",
            "iam_instance_profile": "swift-ssm-managed-profile",
            "tenancy": "dedicated",
            "associate_public_ip_address": false,
            "subnet_id": "subnet-swift-priv-001",
            "metadata_options": [
              { "http_endpoint": "enabled", "http_tokens": "required", "http_put_response_hop_limit": 1 }
            ],
            "root_block_device": [
              { "encrypted": true, "volume_type": "gp3", "kms_key_id": "arn:aws:kms:eu-west-1:111122223333:key/swift-ebs" }
            ],
            "tags": { "swift:zone": "secure", "swift:role": "reporting", "Project": "swift-cscf" }
          }
        },
        {
          "address": "aws_vpc_endpoint.s3",
          "type": "aws_vpc_endpoint",
          "name": "s3",
          "values": {
            "service_name": "com.amazonaws.eu-west-1.s3",
            "vpc_endpoint_type": "Gateway",
            "vpc_id": "vpc-swift-001",
            "tags": { "swift:zone": "secure", "Project": "swift-cscf" }
          }
        },
        {
          "address": "aws_db_instance.reporting_db",
          "type": "aws_db_instance",
          "name": "reporting_db",
          "values": {
            "engine": "postgres",
            "publicly_accessible": false,
            "username": "reportadmin",
            "manage_master_user_password": true,
            "iam_database_authentication_enabled": true,
            "tags": { "swift:zone": "secure", "Project": "swift-cscf" }
          }
        },
        {
          "address": "aws_s3_bucket_public_access_block.exports",
          "type": "aws_s3_bucket_public_access_block",
          "name": "exports",
          "values": {
            "bucket": "swift-reporting-exports",
            "block_public_acls": true,
            "block_public_policy": true,
            "ignore_public_acls": true,
            "restrict_public_buckets": true
          }
        },
        {
          "address": "aws_lambda_function.exporter",
          "type": "aws_lambda_function",
          "name": "exporter",
          "values": {
            "function_name": "swift-report-exporter",
            "environment": [
              {
                "variables": {
                  "DB_HOST": "reporting_db",
                  "DB_SECRET_ARN": "arn:aws:secretsmanager:eu-west-1:111122223333:secret:swift/reporting/db"
                }
              }
            ],
            "tags": { "swift:zone": "secure", "Project": "swift-cscf" }
          }
        },
        {
          "address": "aws_secretsmanager_secret.reporting",
          "type": "aws_secretsmanager_secret",
          "name": "reporting",
          "values": {
            "name": "swift/reporting/db",
            "kms_key_id": "arn:aws:kms:eu-west-1:111122223333:key/swift-secrets-cmk",
            "tags": { "swift:zone": "secure", "Project": "swift-cscf" }
          }
        }
      ],
      "child_modules": []
    }
  }
}
